# Clinic AI Platform — environment variables
#
# These are the only variables Phase 0 reads. They are consumed exclusively by
# src/lib/env.ts, which is the single file in this repo permitted to read
# process.env — see CONTRIBUTING.md. Later phases will add database,
# authentication, and AI provider variables here.

# Public base URL of the deployed app (used for absolute links, metadata, etc.).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment environment label. One of: development | staging | production
NEXT_PUBLIC_APP_ENV=development
