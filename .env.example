# Clinic AI Platform — environment variables
#
# These are consumed exclusively by src/lib/env.ts, which is the single file
# in this repo permitted to read process.env — see CONTRIBUTING.md. Later
# phases will add authentication and AI provider variables here.

# Public base URL of the deployed app (used for absolute links, metadata, etc.).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment environment label. One of: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# --- Database (P1 foundation — see docs/adr/0006-rls-tenant-context-propagation.md) ---

# Owner/migration connection: runs db/migrations/*.sql (creates the app_user
# role, tables, and RLS policies). Requires a local Postgres 16+ instance —
# see CONTRIBUTING.md for setup. Never used by the running application.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic_ai_platform

# Least-privilege runtime connection: the actual application and the
# automated tenant-isolation tests use this, never DATABASE_URL. Deliberately
# NOT the table owner — see docs/technical/02-tenant-isolation-testing.md and
# db/migrations/0002_app_role.sql for why. The password below is a
# local/CI development placeholder, not a production credential — a real
# deployment sets its own value for both variables below outside this repo.
APP_DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/clinic_ai_platform

# The app_user role's password, used only by `npm run db:migrate` to set it
# via a parameterized statement — never embedded in a migration file. Must
# match the password in APP_DATABASE_URL above.
APP_USER_PASSWORD=app_user_dev_password

# --- Deployment validation seed (scripts/seed.ts) — see README.md ---

# Plaintext password for the seed's one demo staff account, hashed before
# it touches the database and never read by the running application.
# Rejected if shorter than 12 characters. The value below is a local/CI
# placeholder only — choose a fresh value on the command line for any real
# deployment run instead of using this default.
SEED_STAFF_PASSWORD=demo-seed-password-please-change

# Explicit override required to run `npm run db:seed` when
# NEXT_PUBLIC_APP_ENV=production. Left unset here on purpose: uncomment and
# set to exactly "true" only when intentionally seeding a deployed
# environment.
# SEED_FORCE=true
